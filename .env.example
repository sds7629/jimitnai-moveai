# Copy to .env (which is gitignored) before running `docker compose up`.
# docker compose automatically loads a `.env` file next to
# docker-compose.yml for ${VAR} substitution, and the same values are also
# passed explicitly into the `backend` service's `environment:` block.

# --- Postgres superuser (table owner; also used for /docker-entrypoint-initdb.d
# init scripts and for logging into adminer with full visibility) ---
POSTGRES_DB=moveai
POSTGRES_USER=moveai
POSTGRES_PASSWORD=moveai

# --- Backend application DB role (least-privilege; see
# db/init/004-permissions.sql). The backend connects as THIS role, not as
# POSTGRES_USER, so that UPDATE/DELETE on append-only tables
# (audit_log, operational_snapshots, simulation_results, approvals) is
# rejected by Postgres itself, not just by application convention. ---
APP_DB_USER=moveai_app
APP_DB_PASSWORD=moveai_app
DATABASE_URL=postgresql+psycopg://moveai_app:moveai_app@db:5432/moveai

# --- App runtime ---
APP_ENV=docker
FRONTEND_ORIGIN=http://localhost:5173

# --- LLM provider (feature/llm-provider owns backend/app/llm/; these vars
# are wired through by platform-infra so that module can read them once
# merged) ---
LLM_PROVIDER=gemini_api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
